# =========================================================
# LOCAL env template. Copy to .env.local (gitignored):
#
#   cp .env.local.example .env.local
#
# Loaded by `docker compose` (--env-file) for port/credential interpolation,
# and as the SECOND env_file for the backend and frontend containers, where it
# overrides only the host-specific values (localhost -> compose service names).
# App config itself stays in backend/.env and frontend/.env (both bind-mounted).
# Do NOT put inline `# comments` after a value here - compose keeps them.
# =========================================================

# ----- Host-side ports -----
POSTGRES_PORT=5462
POSTGRES_TEST_PORT=5463
REDIS_PORT=6379
BACKEND_PORT=4800
FRONTEND_PORT=3800
DRIZZLE_STUDIO_PORT=4983

# ----- Postgres service credentials -----
# Keep in sync with DATABASE_URL below and with backend/.env.test.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=slapshot_club
POSTGRES_TEST_DB=slapshot_club_test

# ----- In-container overrides for backend/.env -----
# Inside the compose network the backend reaches postgres/redis by service
# name, not via the host-mapped ports.
DATABASE_URL=postgres://user:password@postgres:5432/slapshot_club
REDIS_URL=redis://redis:6379
NODE_ENV=development

# ----- In-container override for frontend/.env -----
# The next server does the /api/v1 rewrite and the SSR fetches, so it needs the
# service name. The browser never uses this value for api calls (it goes through
# the rewrite on the same origin), only for a preconnect hint.
NEXT_PUBLIC_API_URL=http://backend:4800

# ----- Optional: file watching -----
# Uncomment if edits on the host do not trigger a reload inside the containers.
# CHOKIDAR_USEPOLLING=true
# WATCHPACK_POLLING=true
